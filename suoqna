const categories = [

    ["سيارات", "cars", "🚗"],

    ["عقارات", "real-estate", "🏠"],

    ["موبايلات", "phones", "📱"],

    ["إلكترونيات", "electronics", "💻"],

    ["خدمات", "services", "🛠️"],

    ["وظائف", "jobs", "💼"],

    ["ملابس وأزياء", "fashion", "👕"],

    ["أخرى", "other", "📦"]

];


let listings =
    JSON.parse(
        localStorage.getItem(
            "souqna_listings"
        ) || "[]"
    );


const $ = id =>
    document.getElementById(id);


function setupCategories() {

    const options =
        categories
            .map(
                category =>

                `<option value="${category[1]}">
                    ${category[0]}
                </option>`

            )
            .join("");


    $("categoryFilter").innerHTML =
        `<option value="">
            كل الأقسام
        </option>`
        +
        options;


    $("formCategory").innerHTML =
        `<option value="">
            اختر القسم
        </option>`
        +
        options;


    $("categories").innerHTML =

        categories
            .map(
                category =>

                `<div
                    class="category-card"
                    onclick="filterCategory('${category[1]}')">

                    <div class="category-icon">
                        ${category[2]}
                    </div>

                    <b>
                        ${category[0]}
                    </b>

                </div>`

            )
            .join("");

}


function filterCategory(category) {

    $("categoryFilter").value =
        category;

    renderListings();

}


function renderListings() {

    const query =
        $("searchInput")
            .value
            .trim()
            .toLowerCase();


    const category =
        $("categoryFilter")
            .value;


    const filtered =
        listings.filter(
            item =>

            (
                !query ||

                (
                    item.title
                    +
                    item.description
                    +
                    item.city
                )
                .toLowerCase()
                .includes(query)

            )

            &&

            (
                !category
                ||
                item.category === category
            )

        );


    $("listingCount")
        .textContent =
        `${filtered.length} إعلان`;


    if (
        filtered.length === 0
    ) {

        $("listings").innerHTML =

            `<p>
                لا توجد إعلانات مطابقة حالياً.
            </p>`;

        return;

    }


    $("listings").innerHTML =

        filtered
            .map(
                item =>

                `<article class="listing-card">

                    <img
                        src="${
                            item.image
                            ||
                            'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=800'
                        }"
                        alt="${item.title}">

                    <div class="listing-body">

                        <h3 class="listing-title">
                            ${item.title}
                        </h3>

                        <div class="price">

                            ${
                                item.price

                                ?

                                Number(
                                    item.price
                                )
                                .toLocaleString(
                                    "ar-SA"
                                )
                                +
                                " ريال"

                                :

                                "السعر عند التواصل"
                            }

                        </div>

                        <p class="muted">

                            ${
                                item.city
                                ||
                                "الموقع غير محدد"
                            }

                            ·

                            ${
                                item.categoryName
                                ||
                                "أخرى"
                            }

                        </p>

                        <p>
                            ${
                                item.description
                                ||
                                ""
                            }
                        </p>

                    </div>

                </article>`

            )
            .join("");

}


$("searchBtn")
    .onclick =
    renderListings;


$("searchInput")
    .oninput =
    renderListings;


$("categoryFilter")
    .onchange =
    renderListings;


$("postBtn")
    .onclick = () => {

        $("listingModal")
            .classList
            .remove("hidden");

    };


$("closeModal")
    .onclick = () => {

        $("listingModal")
            .classList
            .add("hidden");

    };


$("loginBtn")
    .onclick = () => {

        alert(
            "سيتم ربط تسجيل الدخول مع Supabase Auth في المرحلة التالية."
        );

    };


$("listingForm")
    .onsubmit = event => {

        event.preventDefault();


        const category =
            $("formCategory")
                .value;


        const categoryInfo =
            categories.find(
                item =>
                    item[1] === category
            );


        const newListing = {

            title:
                $("title").value,

            description:
                $("description").value,

            price:
                $("price").value,

            city:
                $("city").value,

            category:

                category
                ||
                "other",

            categoryName:

                categoryInfo
                ?
                categoryInfo[0]
                :
                "أخرى",

            image:
                $("image").value

        };


        listings.unshift(
            newListing
        );


        localStorage.setItem(
            "souqna_listings",

            JSON.stringify(
                listings
            )
        );


        event.target.reset();


        $("listingModal")
            .classList
            .add("hidden");


        renderListings();

    };


setupCategories();

renderListings();


